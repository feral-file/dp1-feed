{
  "_comment": "playlists[] controls upload order and the Feral File channel's playlist order. metadata{} holds optional per-exhibition playlist overrides (title, summary, coverImage); curators are normally embedded directly in each playlist file by generate-ff-playlist.js (from exhibition.curatorAlumni) and only need a manifest override in rare cases. channel{} is the single persistent Feral File channel (id is filled in automatically after first creation, do not edit manually). Entity.key (curators/publisher) accepts did:key:z... (Ed25519 pubkey) or did:pkh:eip155:{chainId}:0x... (CAIP-10 Ethereum address) per the DP-1 JSON Schema pattern ^did:[a-z]+:.+$ enforced by the production feed server (dp1-go); Feral File only has wallet addresses for curators/publisher, so did:pkh is what's actually used.",
  "channel": {
    "id": null,
    "slug": "feral-file",
    "title": "Feral File",
    "publisher": {
      "name": "Feral File",
      "key": "did:pkh:eip155:1:0x1d05cf6c6BEb0c869851BFdb9510D4E44E855ad6",
      "url": "https://feralfile.com"
    },
    "summary": "Feral File is a platform for digital art exhibitions, publishing, and collecting. This channel brings together artworks from all Feral File exhibitions in one place.",
    "coverImage": null
  },
  "playlists": [
    "social-codes-pcl",
    "gray-matter-dn1",
    "net-evil-das"
  ],
  "playlistUrls": {
    "social-codes-pcl": "https://feed.feralfile.com/api/v1/playlists/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
    "gray-matter-dn1": "https://feed.feralfile.com/api/v1/playlists/yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy"
  },
  "metadata": {
    "social-codes-pcl": {
      "title": "Social Codes",
      "summary": "Custom summary override (max 2000 chars, or set --summary-provider to auto-truncate).",
      "coverImage": "https://imagedelivery.net/iCRs13uicXIPOWrnuHbaKA/xxxxxxxx/raw"
    }
  }
}
